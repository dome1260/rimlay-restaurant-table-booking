NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...). Never expose to the browser.
SUPABASE_SECRET_KEY=

# Used only by `npm run seed` to create the test back-office accounts.
SEED_ADMIN_EMAIL=
SEED_STAFF_EMAIL=
SEED_TEST_PASSWORD=

# Phase 2B: Gmail SMTP (Nodemailer) for customer emails. Leave empty until an App Password exists;
# without them emails are only recorded in the email_outbox table.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Shared secret for POST /api/jobs/emails (queued email worker)
CRON_SECRET=

# Phase 6: the production Supabase URL. When the local app points at it, the dev clock and
# "run jobs" button are disabled so test runs can't touch real bookings.
PRODUCTION_SUPABASE_URL=
